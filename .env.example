# Application server port
PORT=8080

# Storage backend strategy: "redis" or "memory"
STORAGE_TYPE=redis

# Redis connection URL (supports redis:// for local and rediss:// for TLS in production)
REDIS_URL=redis://localhost:6379/0

# IP-based rate limiting settings
RATE_BY_IP_TIME_WINDOW=5         # Time window in seconds for counting requests per IP
RATE_BY_IP_MAX_REQUESTS=2        # Maximum allowed requests per IP within the time window
RATE_BY_IP_BLOCKED_DURATION=60   # Duration in seconds an IP remains blocked after exceeding the limit

# Token-based rate limiting settings
ENABLE_TOKEN_LIMITING=true       # Enable or disable API_KEY token-based rate limiting
DEFAULT_TOKEN_TTL=40             # Default token lifetime in seconds when not specified

# Failure policy when the rate-limiter storage backend is unavailable
FAIL_OPEN=false                  # false = fail-closed (503 Service Unavailable), true = fail-open (allow requests)
