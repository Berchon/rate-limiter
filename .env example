# Porta da aplicação
APP_PORT=8080

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Rate Limiter por IP
RATE_BY_IP_TIME_WINDOW=5         # tempo em segundos considerado para calcular o limite de requisições de cada IP
RATE_BY_IP_MAX_REQUESTS=2        # máximo de requisições por IP por janela
RATE_BY_IP_BLOCKED_DURATION=60   # segundos que o IP fica bloqueado se atingir limite

# Rate Limiter por Token
ENABLE_TOKEN_LIMITING=true        # habilita rate limiter baseado em token
DEFAULT_TOKEN_TTL=40            # segundos, tempo de vida padrão do token
